---
/**
 * One chapter of copy over the pinned stage. Seven of these across one sequence is what
 * makes a single canvas read as seven sections. Copy sits on the side of the frame the
 * footage leaves empty (measured per scene; recorded in production-notes.md).
 */
import type { Chapter } from "../content/site";
type Props = Chapter & { level?: 1 | 2 };
const { id, at, numeral, eyebrow, heading, headingEm, body, cta, secondary, side = "left", level = 2 } = Astro.props;
const H = `h${level}` as "h1" | "h2";
---

<div class:list={["chapter", `chapter--${id}`, `chapter--${side}`]} data-chapter={id} data-at={JSON.stringify(at)}>
  <div class="chapter__inner">
    {(numeral || eyebrow) && (
      <p class="chapter__eyebrow">
        {numeral && <span class="numeral">{numeral}</span>}
        {eyebrow && <span class="chapter__label">{eyebrow}</span>}
      </p>
    )}
    <H class:list={["chapter__heading", level === 1 && "is-hero"]}>
      <span class="lustre">{heading}</span>{headingEm && <><br /><em class="lustre">{headingEm}</em></>}
    </H>
    {body && <p class="chapter__body">{body}</p>}
    {(cta || secondary) && (
      <div class="chapter__actions">
        {cta && <a class="btn btn--primary" href={cta.href}>{cta.label}</a>}
        {secondary && <a class="btn btn--quiet" href={secondary.href}>{secondary.label} →</a>}
      </div>
    )}
  </div>
</div>

<style>
  .chapter {
    position: absolute; inset: 0;
    display: grid; align-items: center;
    width: min(100% - 2 * var(--gutter), var(--wrap));
    margin-inline: auto;
    padding-block: calc(var(--nav-h) + var(--sp-6)) var(--sp-9);
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 900ms;
  }
  .chapter--right { justify-items: end; }
  .chapter.is-on { visibility: visible; transition-delay: 0s; }
  .chapter.is-on .chapter__inner { pointer-events: auto; }

  .chapter__inner { max-width: var(--measure); display: grid; gap: var(--sp-5); justify-items: start; }
  .chapter--hero .chapter__inner { max-width: 42rem; }
  .chapter--close .chapter__inner { max-width: 54rem; }

  /* Staggered reveal: each line surfaces out of the dark in turn, like light finding
     a panel. */
  .chapter__inner > * {
    opacity: 0; transform: translateY(18px); filter: blur(8px);
    transition: opacity 900ms var(--ease-out), transform 900ms var(--ease-out), filter 900ms var(--ease-out);
  }
  .chapter.is-on .chapter__inner > * { opacity: 1; transform: none; filter: none; }
  .chapter.is-on .chapter__inner > :nth-child(2) { transition-delay: 90ms; }
  .chapter.is-on .chapter__inner > :nth-child(3) { transition-delay: 180ms; }
  .chapter.is-on .chapter__inner > :nth-child(4) { transition-delay: 270ms; }

  .chapter__eyebrow {
    display: inline-flex; align-items: center; gap: var(--sp-4); margin: 0;
    font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: var(--tracking-label);
    text-transform: uppercase; color: var(--silver);
  }
  .chapter__eyebrow .numeral { font-size: var(--step--2); }
  .chapter__eyebrow::before {
    content: ""; width: 28px; height: 1px; background: var(--halcyon);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .chapter__heading {
    font-family: var(--font-display); font-weight: 200;
    font-size: var(--step-3); line-height: 1.04; letter-spacing: var(--tracking-display);
    margin: 0; color: var(--platinum);
    text-wrap: balance;
  }
  .chapter__heading em { font-style: normal; font-weight: 400; }
  .chapter__heading.is-hero { font-size: var(--step-4); line-height: 0.98; }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .lustre {
      background: var(--lustre);
      -webkit-background-clip: text; background-clip: text; color: transparent;
      -webkit-box-decoration-break: clone; box-decoration-break: clone;
    }
  }
  .chapter__body { margin: 0; color: var(--ink-muted); font-size: var(--step-0); max-width: 30rem; text-wrap: pretty; }

  .chapter__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-4) var(--sp-6); margin-top: var(--sp-3); }

  @media (max-width: 767px) {
    /* Portrait: the subject sits in the middle band, so copy takes the quiet top of the
       frame. While the film runs only the eyebrow and heading show; the imagery holds the
       screen. The hero and the close keep their action. */
    .chapter { align-items: start; padding-top: calc(var(--nav-h) + var(--sp-5)); justify-items: start; }
    .chapter__inner { gap: var(--sp-3); }
    .chapter__heading { font-size: clamp(1.7rem, 7.6vw, 2.2rem); }
    .chapter__heading.is-hero { font-size: clamp(2.3rem, 11vw, 3rem); }
    .chapter__body { display: none; }
    .chapter--close .chapter__body { display: block; font-size: 0.95rem; line-height: 1.5; }
    .chapter--hero .btn--quiet, .chapter--close .btn--quiet { display: none; }
    /* Decorative eyebrow cut on phones: it wraps to two lines and pushes the hero's one
       action down onto the cell (mobile.md: the opening screen carries headline + action). */
    .chapter--hero .chapter__eyebrow { display: none; }
    .chapter__actions { margin-top: var(--sp-2); }
    /* The close's CTA carries the deposit terms; keep it on one line at 360px. */
    .chapter .btn { letter-spacing: 0.14em; padding-inline: var(--sp-4); }
    /* The close sits at the bottom: its frame is empty sky on top and water below, and the
       CTA belongs near the thumb. */
    .chapter--close { align-items: end; padding-bottom: calc(var(--sp-8) + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 767px) and (max-height: 700px) {
    .chapter--close .chapter__body { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter__inner > * { transition: none; filter: none; transform: none; }
  }
</style>
