---
import { site } from "../content/site";
const { pathname } = Astro.url;
const home = pathname === "/" || pathname === "";
---

<header class="nav">
  <div class="nav__inner wrap">
    <a class="nav__brand" href="/" aria-label={`${site.brand.name} — home`}>
      <svg class="nav__symbol" viewBox="0 0 64 64" aria-hidden="true">
        <path fill="currentColor" fill-rule="evenodd" d="M14 4 H50 a10 10 0 0 1 10 10 V50 a10 10 0 0 1 -10 10 H14 a10 10 0 0 1 -10 -10 V14 a10 10 0 0 1 10 -10 Z M28.5 18 H35.5 V28.9 H46 V35.1 H35.5 V46 H28.5 V35.1 H18 V28.9 H28.5 Z"/>
      </svg>
      <span class="wordmark nav__word">{site.brand.name}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {site.nav.map((l) => (
        <a href={home ? l.href : `/${l.href}`}>{l.label}</a>
      ))}
    </nav>

    <a class="btn btn--primary nav__cta" href={home ? site.cta.href : `/${site.cta.href}`}>
      {site.cta.label}
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 20;
    height: var(--nav-h);
    /* The stage scrolls under this, so it needs its own ground rather than transparency;
       a blur keeps the footage legible behind it without a hard edge. */
    background: rgba(245, 246, 248, 0.82);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .nav__symbol { width: 22px; height: 22px; }
  .nav__word { font-size: var(--step-0); }

  .nav__links {
    display: flex;
    gap: var(--sp-6);
    margin-inline-start: auto;
  }
  .nav__links a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mid);
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav__links a:hover { color: var(--spark); }

  .nav__cta { flex: none; padding: 0.6em 1.2em; }

  @media (max-width: 900px) {
    /* The links collapse before the CTA does — on a phone, buying beats browsing. */
    .nav__links { display: none; }
    .nav__cta { margin-inline-start: auto; }
  }
  @media (max-width: 420px) {
    .nav__word { display: none; }
  }
</style>
