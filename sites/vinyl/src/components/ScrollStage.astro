---
import Chapter from "./Chapter.astro";
import { site } from "../content/site";
import manifest from "../../public/frames/manifest.json";

// Until the footage lands the manifest carries count 0. In that state the sequence is
// never requested and the page serves the composed-still path for everyone — the same
// path reduced-motion visitors always get.
const hasSequence = manifest.desktop.count > 0 && manifest.mobile.count > 0;
---

<section
  id="stage"
  class="scroller"
  class:list={{ "is-static": !hasSequence }}
  aria-label="How a Lathe & Lacquer record is made, in reverse"
>
  <div class="pin" data-scrim="left">
    <canvas id="seq" aria-hidden="true"></canvas>
    <div class="scrim" aria-hidden="true"></div>

    <noscript>
      <picture>
        <source media="(max-width: 767px)" srcset={manifest.mobile.poster} />
        <img class="poster-fallback" src={manifest.desktop.poster} alt="" />
      </picture>
    </noscript>

    {site.chapters.map((c) => <Chapter {...c} />)}

    <script type="application/json" id="seq-manifest" set:html={JSON.stringify(manifest)}></script>
    <script type="application/json" id="seq-timecode" set:html={JSON.stringify(site.timecode)}></script>

    <!-- The scroll indicator is a track timecode. It runs forward, counts DOWN through
         the reversed section, then forward again from the return — so the readout tells
         the same story the footage does. Decorative: the same information is in the
         chapters, so it stays out of the a11y tree. -->
    <div class="tc" aria-hidden="true">
      <span class="tc__now">00:00</span>
      <span class="tc__track"><span class="tc__head"></span></span>
      <span class="tc__total">{site.timecode.total}</span>
    </div>

    <div class="cue" aria-hidden="true">
      <span class="cue__label">Scroll</span>
      <span class="cue__line"></span>
    </div>
  </div>
</section>

<!-- Reduced motion, no-JS, load failure, and the pre-footage state: the same story as
     readable copy in normal flow, with every action still reachable. -->
<section class="story-static" aria-label="How a Lathe & Lacquer record is made">
  <div class="wrap">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset={manifest.mobile.poster}
        width={manifest.mobile.width}
        height={manifest.mobile.height}
      />
      <img
        class="story-static__poster"
        loading="lazy"
        src={manifest.desktop.poster}
        width={manifest.desktop.width}
        height={manifest.desktop.height}
        alt="A turntable under a single warm lamp in a dark room, the tonearm resting in the groove of a spinning black record."
      />
    </picture>
    <div class="story-static__copy">
      {site.chapters.map((c) => (
        <div class="story-static__beat">
          {c.eyebrow && <p class="eyebrow">{c.eyebrow}</p>}
          <h2>{c.heading}</h2>
          {c.body && <p class="measure">{c.body}</p>}
          {"meta" in c && c.meta && <p class="matrix">{c.meta}</p>}
          {c.cta && <a class="btn btn--primary" href={c.cta.href}>{c.cta.label}</a>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .scroller {
    position: relative;
    height: 1000vh; /* active pinned travel = 9 viewport heights */
  }
  @media (max-width: 767px) {
    .scroller { height: 760vh; } /* 6.6 active — thumbs cover less per effort */
  }

  .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--bg);
  }

  #seq { width: 100%; height: 100%; display: block; }

  .poster-fallback {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
  }

  /* Legibility behind the copy rail. The rake follows the ACTIVE chapter: 01 and 04
     hold their negative space left, 05 holds it right. */
  .scrim {
    position: absolute; inset: 0;
    background: var(--scrim);
    pointer-events: none;
    transition: background 520ms var(--ease), opacity 520ms var(--ease);
  }
  .pin[data-scrim="right"] .scrim { background: var(--scrim-right); }
  .pin[data-scrim="up"] .scrim { background: var(--scrim-up); }
  /* No chapter showing — let the footage carry the frame alone. */
  .pin[data-scrim="none"] .scrim { opacity: 0; }

  @media (max-width: 767px) {
    /* Portrait copy sits over the subject, not beside it, so the scrim goes bottom-up
       in every chapter regardless of its desktop rail. */
    .scrim,
    .pin[data-scrim="up"] .scrim,
    .pin[data-scrim="right"] .scrim {
      background: linear-gradient(
        0deg,
        rgba(13, 13, 13, 0.97) 0%,
        rgba(13, 13, 13, 0.88) 28%,
        rgba(13, 13, 13, 0.55) 52%,
        rgba(13, 13, 13, 0) 88%
      );
    }
  }

  /* The timecode. Monospace, tabular, bottom-right — where a deck's counter sits. */
  .tc {
    position: absolute;
    right: var(--gutter);
    bottom: calc(var(--sp-5) + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-mid);
    color: var(--ink-dim);
  }
  .tc__track {
    position: relative;
    display: block;
    width: 148px;
    height: 1px;
    background: var(--line-strong);
  }
  .tc__head {
    position: absolute;
    top: 50%;
    left: 0;
    width: 7px; height: 7px;
    margin-top: -3.5px; margin-left: -3.5px;
    border-radius: var(--r-pill);
    background: var(--tungsten);
  }
  /* When the playhead is running backwards the readout goes oxblood — the one moment
     the page admits it is running in reverse. */
  .tc.is-reverse { color: var(--oxblood); }
  .tc.is-reverse .tc__head { background: var(--oxblood); }
  .tc.is-reverse .tc__now { color: var(--label-cream); }

  @media (max-width: 767px) {
    .tc { left: var(--gutter); right: var(--gutter); justify-content: space-between; }
    .tc__track { flex: 1; width: auto; }
  }

  .cue {
    position: absolute;
    left: 50%; bottom: calc(var(--sp-4) + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: grid; justify-items: center; gap: var(--sp-2);
    opacity: 0.7;
    transition: opacity 400ms var(--ease);
  }
  .cue.is-gone { opacity: 0; }
  .cue__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .cue__line {
    width: 1px; height: 38px;
    background: linear-gradient(180deg, var(--ink-dim), transparent);
  }
  @media (max-width: 767px) {
    /* The timecode owns the bottom edge on a phone; the cue would collide with it. */
    .cue { display: none; }
  }

  .story-static { display: none; padding: calc(var(--nav-h) + var(--sp-8)) 0 var(--sp-8); }
  .story-static__poster {
    width: 100%; height: auto; display: block;
    border-radius: var(--r-md);
    margin-bottom: var(--sp-7);
  }
  .story-static__copy { display: grid; gap: var(--sp-7); }
  .story-static__beat { display: grid; gap: var(--sp-3); justify-items: start; }
  .story-static__beat h2 { font-size: var(--step-3); }
  .story-static__beat p { color: var(--ink-muted); }

  /* Pre-footage: no sequence exists, so the stage is removed outright rather than
     leaving an empty black viewport, and the readable story carries the page. */
  .scroller.is-static { height: 0; }
  .scroller.is-static .pin { display: none; }
  .scroller.is-static ~ .story-static { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .scroller { height: 100svh; }
    .cue, .tc { display: none; }
    .pin :global(.chapter) { display: none; }
    .story-static { display: block; }
  }
</style>

<noscript>
  <style>
    .scroller { height: 100svh; }
    .cue, .tc { display: none; }
    .story-static { display: block; }
  </style>
</noscript>

<script>
  import { ScrollEngine, type SequenceSpec } from "@sites/scroll-engine";
  import { site } from "../content/site";

  // Vite refuses to import from public/ in client code, so the manifest is serialised
  // into the document by the frontmatter above and read back here.
  const manifest = JSON.parse(
    document.getElementById("seq-manifest")!.textContent!,
  ) as { desktop: SequenceSpec; mobile: SequenceSpec };
  const tcSpec = JSON.parse(
    document.getElementById("seq-timecode")!.textContent!,
  ) as { total: string; totalSeconds: number; reverseFrom: number; forwardFrom: number };

  const canvas = document.getElementById("seq") as HTMLCanvasElement | null;
  const scroller = document.getElementById("stage") as HTMLElement | null;
  const hasSequence = manifest.desktop.count > 0 && manifest.mobile.count > 0;

  const mmss = (s: number) => {
    const t = Math.max(0, Math.round(s));
    return `${String(Math.floor(t / 60)).padStart(2, "0")}:${String(t % 60).padStart(2, "0")}`;
  };

  /**
   * Scroll fraction -> playhead seconds. Forward to `reverseFrom`, backwards through
   * the reversed section, forward again from `forwardFrom`. A pure function of
   * progress, like the frame mapping — scrolling up retraces exactly.
   */
  function playhead(p: number, spec: typeof tcSpec) {
    const { totalSeconds: T, reverseFrom: r, forwardFrom: f } = spec;
    // Seconds at the turnaround, and the floor the rewind bottoms out at.
    const peak = T * 0.62;
    const trough = T * 0.18;
    if (p <= r) return { t: (p / r) * peak, reverse: false };
    if (p <= f) {
      const k = (p - r) / (f - r);
      return { t: peak - k * (peak - trough), reverse: true };
    }
    const k = (p - f) / (1 - f);
    return { t: trough + k * (T - trough), reverse: false };
  }

  if (canvas && scroller && hasSequence) {
    const pin = scroller.querySelector<HTMLElement>(".pin");
    const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
    const cue = document.querySelector<HTMLElement>(".cue");
    const tc = document.querySelector<HTMLElement>(".tc");
    const tcNow = tc?.querySelector<HTMLElement>(".tc__now");
    const tcHead = tc?.querySelector<HTMLElement>(".tc__head");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Under reduced motion the chapters never toggle, so the static copy carries the
    // story instead. Keep the overlays out of the a11y tree and the tab order entirely.
    for (const el of chapters) el.inert = true;

    new ScrollEngine({
      canvas,
      scroller,
      landscape: manifest.desktop,
      portrait: manifest.mobile,
      beats: site.beats,
      onProgress(p) {
        if (reduced) return;
        let activeScrim = "none";
        for (const el of chapters) {
          const [a, b] = JSON.parse(el.dataset.at!) as [number, number];
          const on = p >= a && p <= b;
          if (on) activeScrim = el.dataset.scrim ?? "left";
          el.classList.toggle("is-on", on);
          el.inert = !on;
        }
        if (pin && pin.dataset.scrim !== activeScrim) pin.dataset.scrim = activeScrim;
        cue?.classList.toggle("is-gone", p > 0.04);

        const { t, reverse } = playhead(p, tcSpec);
        if (tcNow) tcNow.textContent = mmss(t);
        if (tcHead) tcHead.style.left = `${(t / tcSpec.totalSeconds) * 100}%`;
        tc?.classList.toggle("is-reverse", reverse);
      },
    });
  }
</script>
