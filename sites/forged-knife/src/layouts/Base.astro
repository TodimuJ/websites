---
import "../styles/tokens.css";
import Nav from "../components/Nav.astro";
import { site } from "../content/site";

interface Props {
  title: string;
  description: string;
  /** Where the "Skip the story" / "Skip to content" link jumps to. */
  skipTo?: string;
  skipLabel?: string;
}
const { title, description, skipTo = "#making", skipLabel = "Skip the story" } =
  Astro.props;
const { brand, footer } = site;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="icon" href={brand.symbol} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>

  <body id="top">
    <Nav skipTo={skipTo} skipLabel={skipLabel} />

    <slot />

    <footer class="footer">
      <div class="wrap footer__grid">
        <div class="footer__brand">
          <span class="footer__word">{brand.name}</span>
          <p class="measure footer__note">{footer.note}</p>
        </div>
        {footer.columns.map((c) => (
          <nav class="footer__col" aria-label={c.title}>
            <p class="spec footer__title">{c.title}</p>
            <ul role="list">
              {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>
      <div class="wrap footer__legal">
        <p class="spec">{footer.legal}</p>
      </div>
    </footer>

    <style is:global>
      main { display: block; }

      /* Shared section furniture, used by every page. */
      .section__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-8); }
      .section__head h2 { font-size: var(--step-3); max-width: 18ch; }
      .section__lede { color: var(--ash-dim); }

      /* Footer */
      .footer {
        border-top: 1px solid var(--hairline);
        padding: var(--s-8) 0 var(--s-6);
        background: var(--soot-sunken);
      }
      .footer__grid { display: grid; gap: var(--s-7); grid-template-columns: 1fr; }
      @media (min-width: 700px) {
        .footer__grid { grid-template-columns: 2fr 1fr 1fr; gap: var(--s-8); }
      }
      .footer__word {
        font-family: var(--font-mono);
        font-size: var(--step--1);
        letter-spacing: var(--tracking-wide);
        color: var(--ash);
      }
      .footer__note { color: var(--ash-faint); margin-top: var(--s-3); font-size: var(--step-0); }
      .footer__title {
        color: var(--ash-faint);
        text-transform: uppercase;
        letter-spacing: var(--tracking-mid);
        margin-bottom: var(--s-3);
      }
      .footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
      .footer__col a {
        text-decoration: none;
        color: var(--ash-dim);
        display: inline-flex; align-items: center; min-height: 34px;
        transition: color 160ms var(--ease);
      }
      .footer__col a:hover { color: var(--forge-gold); }
      .footer__legal {
        margin-top: var(--s-7);
        padding-top: var(--s-5);
        border-top: 1px solid var(--hairline);
        color: var(--ash-faint);
      }
    </style>
  </body>
</html>
